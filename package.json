{
  "name": "@smallthinkingmachines/video-context-mcp",
  "version": "0.8.0",
  "description": "Model-agnostic MCP server that turns videos into an interactive, queryable knowledge structure — transcript, keyframes, OCR, and search that any MCP client can scrub lazily",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "video-context-mcp": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smallthinkingmachines/video-context-mcp.git"
  },
  "homepage": "https://github.com/smallthinkingmachines/video-context-mcp#readme",
  "bugs": {
    "url": "https://github.com/smallthinkingmachines/video-context-mcp/issues"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/assets/demo.gif"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "npm run build && node scripts/demo-client.mjs",
    "clean": "rm -rf dist coverage",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp-server",
    "youtube",
    "video",
    "transcript",
    "ocr",
    "keyframes",
    "video-rag",
    "claude-code",
    "codex",
    "antigravity",
    "model-context-protocol"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@lancedb/lancedb": "0.31.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "apache-arrow": "^21.2.0",
    "better-sqlite3": "^13.0.1",
    "tesseract.js": "^7.0.0",
    "unzipper": "^0.12.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/unzipper": "^0.10.11",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
